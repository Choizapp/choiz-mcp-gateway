# --- Shared by all services ---

# Shared secret between the Cloudflare Worker and the gateway.
# The Worker sets this header on every forwarded request; the gateway
# rejects anything without it. Generate once with: openssl rand -hex 32
WORKER_SHARED_SECRET=

# --- Warehouse MCP ---

# Postgres connection string for the data warehouse.
# Use a dedicated read-only role, not the admin user.
WAREHOUSE_DATABASE_URL=postgresql://user:password@data-warehouse.cyeydevhei4c.us-east-1.rds.amazonaws.com:5432/warehouse

# --- Meta Ads MCP ---

# Long-lived Meta (Facebook) Marketing API access token.
# Generated from the Meta for Developers → App → Marketing API flow.
# Rotate by updating this value and restarting the stack.
META_ACCESS_TOKEN=

# --- Facebook MCP (multi-tenant: choiz + timeless) ---

# Page access tokens (per tenant) and their respective page IDs.
# Page IDs are public identifiers; tokens are secrets.
FACEBOOK_CHOIZ_ACCESS_TOKEN=
FACEBOOK_CHOIZ_PAGE_ID=
FACEBOOK_TIMELESS_ACCESS_TOKEN=
FACEBOOK_TIMELESS_PAGE_ID=

# --- Instagram MCP (multi-tenant: choiz + timeless) ---

# Per-tenant: long-lived Instagram Business Graph API token + business account id.
# Account IDs are public identifiers; tokens are secrets.
INSTAGRAM_CHOIZ_ACCESS_TOKEN=
INSTAGRAM_CHOIZ_BUSINESS_ACCOUNT_ID=
INSTAGRAM_TIMELESS_ACCESS_TOKEN=
INSTAGRAM_TIMELESS_BUSINESS_ACCOUNT_ID=

# Shared by both Instagram tenants — same Choiz Facebook app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Google Ads MCP (single tenant: Choiz only) ---

# OAuth credentials for the bot user (hola@choiz.com.mx) that has access to
# the Choiz MCC. Mint the refresh token by running setup_oauth.py once from
# the Choizapp/choiz-google-ads-mcp repo with the bot user signed in.
# CLIENT_ID/SECRET come from the OAuth client in the Choiz "MCPs" GCP project
# (APIs & Services → Credentials → "OAuth 2.0 Client IDs", Desktop type).
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=

# Developer token from the Google Ads MCC (3916621621). Standard access only;
# does NOT depend on the OAuth user. Shared across all sub-accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Manager (MCC) customer id, digits only. 3916621621 = Choiz MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=3916621621

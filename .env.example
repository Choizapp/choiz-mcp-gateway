# HTTP port the gateway listens on (inside the container)
PORT=8080

# Warehouse MCP: read-only Postgres connection string
# Use a dedicated read-only Postgres role, not the admin user.
WAREHOUSE_DATABASE_URL=postgresql://user:password@host:5432/warehouse

# Shared secret between the Cloudflare Worker and this gateway.
# The Worker sets this header on every forwarded request; the gateway
# rejects anything without it. Generate with: openssl rand -hex 32
WORKER_SHARED_SECRET=
